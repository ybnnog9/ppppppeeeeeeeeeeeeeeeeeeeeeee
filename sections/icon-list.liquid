<section class="section" data-animate>
  <div class="container">
    <div class="section-title">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="icon-list-grid">
      {% for block in section.blocks %}
        <div class="icon-list-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de iconos",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "Beneficios"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Ventajas clave"}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {"type": "text", "id": "title", "label": "Título", "default": "Protección total"},
        {"type": "textarea", "id": "text", "label": "Texto", "default": "Cobertura en tiempo real."}
      ]
    }
  ],
  "presets": [{"name": "Lista de iconos"}]
}
{% endschema %}
