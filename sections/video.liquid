<section class="section" data-animate>
  <div class="container">
    <div class="section-title section-title--center">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      </div>
    </div>
    <div class="video-frame">
      {{ section.settings.video_iframe }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "Demo"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Mira cómo funciona"},
    {"type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Visualiza el producto en acción."},
    {"type": "html", "id": "video_iframe", "label": "Iframe", "default": "<iframe src=\"https://www.youtube.com/embed/dQw4w9WgXcQ\" allowfullscreen></iframe>"}
  ],
  "presets": [{"name": "Video"}]
}
{% endschema %}
