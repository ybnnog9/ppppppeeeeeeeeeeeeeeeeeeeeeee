<section class="section" data-animate>
  <div class="container">
    <div class="section-title section-title--center">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      </div>
    </div>
    <div class="faq-list">
      {% for block in section.blocks %}
        <div class="faq-item" data-accordion {{ block.shopify_attributes }}>
          <button type="button" data-accordion-trigger>
            <span>{{ block.settings.question }}</span>
            <span>+</span>
          </button>
          <div class="faq-item__answer">{{ block.settings.answer }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "FAQ"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes"},
    {"type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Resolvemos las dudas más comunes antes de comprar."}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pregunta",
      "settings": [
        {"type": "text", "id": "question", "label": "Pregunta", "default": "¿Cómo funciona la instalación?"},
        {"type": "textarea", "id": "answer", "label": "Respuesta", "default": "Es plug & play, sin modificaciones ni herramientas especiales."}
      ]
    }
  ],
  "presets": [{"name": "FAQ"}]
}
{% endschema %}
