<section class="section" data-animate>
  <div class="container callout-banner">
    <span class="badge">{{ section.settings.badge }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <a class="button" href="{{ section.settings.link }}">{{ section.settings.cta }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "Oferta"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Oferta limitada"},
    {"type": "textarea", "id": "text", "label": "Texto", "default": "Consigue tu DriveGuard con descuento hoy."},
    {"type": "text", "id": "cta", "label": "CTA", "default": "Comprar ahora"},
    {"type": "url", "id": "link", "label": "Enlace"}
  ],
  "presets": [{"name": "Banner"}]
}
{% endschema %}
