<section class="section" data-animate>
  <div class="container rich-text">
    <h2>{{ section.settings.heading }}</h2>
    <div>{{ section.settings.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Texto enriquecido",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Una historia que conecta"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Contenido",
      "default": "<p>Comparte la esencia de tu marca con una narrativa cuidada, beneficios claros y valores que inspiran confianza.</p>"
    }
  ],
  "presets": [
    {
      "name": "Texto enriquecido"
    }
  ]
}
{% endschema %}
