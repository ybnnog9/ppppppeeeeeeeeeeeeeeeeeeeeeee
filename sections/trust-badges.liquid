<section class="section" data-animate>
  <div class="container">
    <div class="section-title">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="trust-grid">
      {% for block in section.blocks %}
        <div class="trust-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sellos de confianza",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "Confianza"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Compra con tranquilidad"}
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Sello",
      "settings": [
        {"type": "text", "id": "title", "label": "Título", "default": "Pago seguro"},
        {"type": "textarea", "id": "text", "label": "Descripción", "default": "Transacciones protegidas y cifradas."}
      ]
    }
  ],
  "presets": [{"name": "Sellos de confianza"}]
}
{% endschema %}
