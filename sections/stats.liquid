<section class="section" data-animate>
  <div class="container">
    <div class="section-title section-title--center">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="stats-grid">
      {% for block in section.blocks %}
        <div class="stat-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.value }}</h3>
          <p>{{ block.settings.label }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Estadísticas",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "Resultados"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Datos en los que confiar"}
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Dato",
      "settings": [
        {"type": "text", "id": "value", "label": "Valor", "default": "99.8%"},
        {"type": "text", "id": "label", "label": "Etiqueta", "default": "Precisión"}
      ]
    }
  ],
  "presets": [{"name": "Estadísticas"}]
}
{% endschema %}
