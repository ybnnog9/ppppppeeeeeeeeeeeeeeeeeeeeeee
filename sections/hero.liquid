<section class="section section--hero" data-animate>
  <div class="container hero">
    <div class="hero__content">
      <span class="badge">{{ section.settings.badge }}</span>
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      <p class="hero__subtitle">{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        <a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        <a class="button button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      </div>
      <div class="hero__stats">
        <div>
          <p class="hero__stat-value">{{ section.settings.stat_one_value }}</p>
          <p class="hero__stat-label">{{ section.settings.stat_one_label }}</p>
        </div>
        <div>
          <p class="hero__stat-value">{{ section.settings.stat_two_value }}</p>
          <p class="hero__stat-label">{{ section.settings.stat_two_label }}</p>
        </div>
        <div>
          <p class="hero__stat-value">{{ section.settings.stat_three_value }}</p>
          <p class="hero__stat-label">{{ section.settings.stat_three_label }}</p>
        </div>
      </div>
    </div>
    <div class="hero__media">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading }}">
      {% else %}
        <img src="https://images.unsplash.com/photo-1489515217757-5fd1be406fef?auto=format&fit=crop&w=900&q=80" alt="Tecnología avanzada">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta",
      "default": "DriveGuard AI™"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Seguridad inteligente para tu vehículo"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Protege tu vehículo con IA de última generación y monitoreo continuo en tiempo real desde cualquier lugar."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Texto del botón principal",
      "default": "Comprar ahora"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Enlace del botón principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texto del botón secundario",
      "default": "Más información"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Enlace del botón secundario"
    },
    {
      "type": "text",
      "id": "stat_one_value",
      "label": "Valor estadística 1",
      "default": "99.8%"
    },
    {
      "type": "text",
      "id": "stat_one_label",
      "label": "Etiqueta estadística 1",
      "default": "Precisión"
    },
    {
      "type": "text",
      "id": "stat_two_value",
      "label": "Valor estadística 2",
      "default": "24/7"
    },
    {
      "type": "text",
      "id": "stat_two_label",
      "label": "Etiqueta estadística 2",
      "default": "Protección"
    },
    {
      "type": "text",
      "id": "stat_three_value",
      "label": "Valor estadística 3",
      "default": "+50K"
    },
    {
      "type": "text",
      "id": "stat_three_label",
      "label": "Etiqueta estadística 3",
      "default": "Usuarios"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
