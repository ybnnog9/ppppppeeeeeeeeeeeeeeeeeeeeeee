<section class="section" data-animate>
  <div class="container">
    <div class="section-title">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="bundle-grid">
      {% for block in section.blocks %}
        <div class="bundle-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "Bundle"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Ofertas combinadas"}
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Pack",
      "settings": [
        {"type": "text", "id": "title", "label": "Título", "default": "Pack familiar"},
        {"type": "textarea", "id": "text", "label": "Texto", "default": "Ahorra al llevar 2 unidades."}
      ]
    }
  ],
  "presets": [{"name": "Bundle"}]
}
{% endschema %}
