<section class="section" data-animate>
  <div class="container">
    <div class="section-title section-title--center">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <table class="specs-table">
      {% for block in section.blocks %}
        <tr {{ block.shopify_attributes }}>
          <th>{{ block.settings.label }}</th>
          <td>{{ block.settings.value }}</td>
        </tr>
      {% endfor %}
    </table>
  </div>
</section>

{% schema %}
{
  "name": "Especificaciones",
  "settings": [
    {"type": "text", "id": "badge", "label": "Etiqueta", "default": "Specs"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Especificaciones técnicas"}
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Especificación",
      "settings": [
        {"type": "text", "id": "label", "label": "Etiqueta", "default": "Resolución"},
        {"type": "text", "id": "value", "label": "Valor", "default": "4K Ultra HD"}
      ]
    }
  ],
  "presets": [{"name": "Especificaciones"}]
}
{% endschema %}
