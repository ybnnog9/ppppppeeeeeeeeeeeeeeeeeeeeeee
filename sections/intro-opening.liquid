{% comment %}
  Intro Opening Overlay (Video)
  - Sube videos a Shopify Files y pega las URLs en settings.
{% endcomment %}

<div
  id="IntroOpening"
  class="intro"
  data-show-once="{{ section.settings.show_once }}"
  data-storage-key="{{ section.settings.storage_key | escape }}"
  data-start-muted="{{ section.settings.start_muted }}"
  aria-hidden="true"
>
  <div class="intro__backdrop"></div>

  <video
    id="IntroVideo"
    class="intro__video"
    playsinline
    preload="metadata"
    muted
    poster="{{ section.settings.poster | image_url }}"
  >
    {% if section.settings.webm_url != blank %}
      <source src="{{ section.settings.webm_url | escape }}" type="video/webm">
    {% endif %}
    {% if section.settings.mp4_url != blank %}
      <source src="{{ section.settings.mp4_url | escape }}" type="video/mp4">
    {% endif %}
  </video>

  <div class="intro__ui" role="dialog" aria-modal="true" aria-label="Intro">
    <div class="intro__panel">
      {% if section.settings.title != blank %}
        <h1 class="intro__title">{{ section.settings.title }}</h1>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="intro__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="intro__actions">
        <button id="IntroEnterBtn" class="btn3d" type="button">
          <span class="btn3d__face">Entrar</span>
          <span class="btn3d__shadow" aria-hidden="true"></span>
        </button>

        {% if section.settings.allow_skip %}
          <button id="IntroSkipBtn" class="intro__skip" type="button">Saltar intro</button>
        {% endif %}
      </div>

      {% if section.settings.hint != blank %}
        <p class="intro__hint">{{ section.settings.hint }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Intro Opening (Video)",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Bienvenido" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Una experiencia de lujo mecánico" },
    { "type": "text", "id": "hint", "label": "Texto pequeño", "default": "Pulsa Entrar para comenzar" },

    { "type": "url", "id": "webm_url", "label": "Video WebM (VP9) URL" },
    { "type": "url", "id": "mp4_url", "label": "Video MP4 (H.264) URL" },
    { "type": "image_picker", "id": "poster", "label": "Poster (imagen)" },

    { "type": "checkbox", "id": "allow_skip", "label": "Permitir Saltar intro", "default": true },
    { "type": "checkbox", "id": "start_muted", "label": "Empezar en mute", "default": true },

    { "type": "checkbox", "id": "show_once", "label": "Mostrar solo una vez (por navegador)", "default": true },
    { "type": "text", "id": "storage_key", "label": "Storage key", "default": "intro_opening_seen_v1" }
  ],
  "presets": [
    { "name": "Intro Opening (Video)" }
  ]
}
{% endschema %}
