<section class="section" data-animate>
  <div class="container">
    <div class="section-title section-title--center">
      <div>
        <span class="badge">{{ section.settings.badge }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      </div>
    </div>
    <div class="image-gallery">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="image-gallery__item" {{ block.shopify_attributes }}>
            <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.alt | escape }}">
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Galería de imágenes",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta",
      "default": "Galería"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Detalles en alta definición"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Añade tus imágenes del producto para mostrar cada ángulo y característica clave."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Texto alternativo",
          "default": "Imagen del producto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galería de imágenes",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
