<article class="product-card">
  <a href="{{ product.url }}">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 480 }}" alt="{{ product.title }}">
    {% endif %}
    <h3 class="product-card__title">{{ product.title }}</h3>
    {% render 'price', product: product %}
  </a>
</article>
